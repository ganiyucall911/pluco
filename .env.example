# Wallet that deploys the contracts. Never commit the real key.
PRIVATE_KEY=

# Fee recipient. All fees are native ETH on Base.
TREASURY=0xcaEC37D3AdcE9a141BF5d78895cb3074Fae77AD9

# 8453 = Base mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_PLUCO_CHAIN_ID=8453
NEXT_PUBLIC_PLUCO_REGISTRY=
NEXT_PUBLIC_PLUCO_MARKETPLACE=
NEXT_PUBLIC_PLUCO_ART_CONTRACT=

# Set when hosting under a subpath (GitHub Pages project site).
# NEXT_PUBLIC_BASE_PATH=/pluco
